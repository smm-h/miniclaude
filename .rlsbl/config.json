{
  "targets": [
    "pypi",
    "npm"
  ],
  "pipelines": {
    "pypi": {
      "type": "pypi",
      "local": false,
      "target": "pypi"
    },
    "npm": {
      "type": "npm",
      "local": false,
      "provenance": true,
      "target": "npm"
    }
  },
  "publish_mode": "ci",
  "push_timeout": 120,
  "coverage_unit": "commit"
}
