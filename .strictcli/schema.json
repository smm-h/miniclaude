  "project_id": "miniclaude",
  "name": "miniclaude",
  "version": "0.2.1",
  "help": "A lean, snappy fullscreen terminal client for Claude Code",
  "commands": {
    "version": {
      "name": "version",
      "help": "Print the miniclaude version",
      "effect": "read_only"
    },
    "repl": {
      "name": "repl",
      "help": "Start the interactive fullscreen REPL",
      "effect": "mutating",
      "flags": [
        {
          "name": "profile",
          "help": "claudewheel profile to use",
          "value_schema": {
            "type": "string"
          },
          "presence": "required"
        },
        {
          "name": "model",
          "help": "Model to use, e.g. sonnet, haiku",
          "value_schema": {
            "type": "string"
          },
          "presence": "required"
        },
        {
          "name": "permission-mode",
          "help": "Permission mode",
          "value_schema": {
            "type": "string",
            "enum": [
              "default",
              "acceptEdits",
              "plan",
              "bypassPermissions",
              "dontAsk",
              "auto"
            ]
          },
          "presence": "required",
          "choices": [
            {
              "value": "default",
              "help": "ask before every edit and command"
            },
            {
              "value": "acceptEdits",
              "help": "accept file edits without asking"
            },
            {
              "value": "plan",
              "help": "plan only -- propose, never act"
            },
            {
              "value": "bypassPermissions",
              "help": "ask for nothing at all"
            },
            {
              "value": "dontAsk",
              "help": "act without asking, refusing what needs consent"
            },
            {
              "value": "auto",
              "help": "let Claude Code pick the mode"
            }
          ]
        },
        {
          "name": "cwd",
          "help": "Working directory. Omitted, the REPL runs in the current directory.",
          "value_schema": {
            "type": "string"
          },
          "presence": "optional"
        },
        {
          "name": "session",
          "help": "Which session the REPL runs",
          "presence": "default",
          "default": {
            "choice": "new-session"
          },
          "choices": [
            {
              "name": "resume",
              "help": "Resume a previous session by ID",
              "flags": [
                {
                  "name": "value",
                  "help": "ID of the session to resume",
                  "value_schema": {
                    "type": "string"
                  },
                  "presence": "required"
                }
              ]
            },
            {
              "name": "continue-session",
              "help": "Continue the most recent session"
            },
            {
              "name": "new-session",
              "help": "Start a fresh session"
            }
          ],
          "elect_by": "member-flags"
        }
      ]
    },
    "mock": {
      "name": "mock",
      "help": "Interactive REPL against a mock session for TUI testing — no Claude CLI needed.",
      "effect": "mutating",
      "flags": [
        {
          "name": "seed",
          "help": "Random seed (integer) for reproducible content. Omitted, one is picked at random.",
          "value_schema": {
            "type": "string"
          },
          "presence": "optional"
        }
      ]
    }
  }
}
